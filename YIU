-- ประวัติตำแหน่งของวัตถุในฉาก (เก็บย้อนหลัง ~5.5 วินาที)
local objectHistory = {}
local maxHistorySeconds = 5.5
local lastRecordClock = 0

local function isTrackableObject(part)
	if not part:IsA("BasePart") then return false end
	if part == aimRing then return false end
	if part.Name:match("^Meteor_") or part.Name:match("^Nova_") then return false end
	if isPlayerPart(part) then return false end
	if part.Size.Magnitude > 140 then return false end -- ข้ามพื้นดินขนาดใหญ่พิเศษเพื่อลดภาระเครื่อง
	return true
end

RunService.Heartbeat:Connect(function()
	if isRewinding then return end
	local now = os.clock()
	if now - lastRecordClock < 0.08 then return end -- บันทึกทุก ~0.08 วิ ให้ลื่นและไม่หน่วงบนมือถือ
	lastRecordClock = now

	local char = LocalPlayer.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	local centerPos = root and root.Position or Camera.CFrame.Position

	local snapMap = {}
	local params = OverlapParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local excludeList = {aimRing}
	if char then
		table.insert(excludeList, char)
	end
	params.FilterDescendantsInstances = excludeList

	-- เก็บวัตถุในรัศมีรอบตัวเพื่อไม่ให้กินแรงเครื่องเกินไป
	local nearbyParts = workspace:GetPartBoundsInRadius(centerPos, 180, params)
	for _, part in ipairs(nearbyParts) do
		if isTrackableObject(part) then
			snapMap[part] = {
				cf = part.CFrame,
				anchored = part.Anchored
			}
		end
	end

	table.insert(objectHistory, {
		t = now,
		parts = snapMap
	})

	local cutoff = now - maxHistorySeconds
	while #objectHistory > 0 and objectHistory[1].t < cutoff do
		table.remove(objectHistory, 1)
	end
end)

-- ฟังก์ชัน ESP
local function applyHighlight(character)
	if not character then return end
	local existing = character:FindFirstChild("VoxelESP_Highlight")
	if espEnabled then
		if not existing then
			local highlight = Instance.new("Highlight")
			highlight.Name = "VoxelESP_Highlight"
			highlight.FillColor = Color3.fromRGB(255, 60, 60)
			highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
			highlight.FillTransparency = 0.5
			highlight.OutlineTransparency = 0
			highlight.Adornee = character
			highlight.Parent = character
		end
	else
		if existing then
			existing:Destroy()
		end
	end
end

local function updateAllESP()
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer and player.Character then
			applyHighlight(player.Character)
		end
	end
end

local function setupPlayer(player)
	if player == LocalPlayer then return end
	player.CharacterAdded:Connect(function(char)
		char:WaitForChild("HumanoidRootPart", 10)
		applyHighlight(char)
	end)
end

for _, player in ipairs(Players:GetPlayers()) do
	setupPlayer(player)
end
Players.PlayerAdded:Connect(setupPlayer)

-- ฟังก์ชันรีเซ็ตเลือดฝั่ง Local
local function refillLocalHealth()
	local char = LocalPlayer.Character
	local humanoid = char and char:FindFirstChildOfClass("Humanoid")
	if humanoid then
		if humanoid.MaxHealth <= 0 then
			humanoid.MaxHealth = 100
		end
		if humanoid.Health < humanoid.MaxHealth then
			humanoid.Health = humanoid.MaxHealth
		end
	end
end

local function bindAutoHeal(character)
	if healConn then
		healConn:Disconnect()
		healConn = nil
	end
	local humanoid = character and character:WaitForChild("Humanoid", 10)
	if not humanoid then return end

	healConn = humanoid.HealthChanged:Connect(function(newHealth)
		if autoHealEnabled and newHealth < humanoid.MaxHealth then
			task.defer(function()
				if autoHealEnabled and humanoid and humanoid.Parent then
					humanoid.Health = humanoid.MaxHealth
				end
			end)
		end
	end)
end

if LocalPlayer.Character then
	bindAutoHeal(LocalPlayer.Character)
end
LocalPlayer.CharacterAdded:Connect(bindAutoHeal)

